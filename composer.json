{
    "name": "arkys/stok-barang",
    "description": "Sistem Manajemen Stok Barang dengan Import Excel",
    "type": "project",
    "require": {
        "php": "^7.4 || ^8.0",
        "mpdf/mpdf": "^8.2",
        "phpoffice/phpspreadsheet": "^5.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
